# Copiá este archivo como backend/.env y completá los valores.
# Nunca subas el .env real al repositorio.

PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Conexión a la base (Render u otro Postgres)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/base

# Opcional: variables separadas si no usás DATABASE_URL
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432

# URL pública del frontend (para los enlaces de reset de contraseña)
FRONTEND_URL=http://localhost:5173

# Correo para el reset de contraseña
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
